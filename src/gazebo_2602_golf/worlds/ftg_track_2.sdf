<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="ftg_boss_world">
    
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- CIRCUITO FINAL BOSS                        -->
    <!-- ========================================== -->
    <model name="boss_arena">
      <static>true</static>
      
      <!-- PAREDES EXTERIORES (16x16m - Púrpura) -->
      <link name="out_n"><pose>0 8 0.5 0 0 0</pose><visual name="v"><geometry><box><size>16.2 0.2 1</size></box></geometry><material><ambient>0.3 0.1 0.4 1</ambient></material></visual><collision name="c"><geometry><box><size>16.2 0.2 1</size></box></geometry></collision></link>
      <link name="out_s"><pose>0 -8 0.5 0 0 0</pose><visual name="v"><geometry><box><size>16.2 0.2 1</size></box></geometry><material><ambient>0.3 0.1 0.4 1</ambient></material></visual><collision name="c"><geometry><box><size>16.2 0.2 1</size></box></geometry></collision></link>
      <link name="out_e"><pose>8 0 0.5 0 0 1.5708</pose><visual name="v"><geometry><box><size>16.2 0.2 1</size></box></geometry><material><ambient>0.3 0.1 0.4 1</ambient></material></visual><collision name="c"><geometry><box><size>16.2 0.2 1</size></box></geometry></collision></link>
      <link name="out_w"><pose>-8 0 0.5 0 0 1.5708</pose><visual name="v"><geometry><box><size>16.2 0.2 1</size></box></geometry><material><ambient>0.3 0.1 0.4 1</ambient></material></visual><collision name="c"><geometry><box><size>16.2 0.2 1</size></box></geometry></collision></link>

      <!-- PAREDES INTERIORES (8x8m - Púrpura) -->
      <link name="in_n"><pose>0 4 0.5 0 0 0</pose><visual name="v"><geometry><box><size>8.2 0.2 1</size></box></geometry><material><ambient>0.3 0.1 0.4 1</ambient></material></visual><collision name="c"><geometry><box><size>8.2 0.2 1</size></box></geometry></collision></link>
      <link name="in_s"><pose>0 -4 0.5 0 0 0</pose><visual name="v"><geometry><box><size>8.2 0.2 1</size></box></geometry><material><ambient>0.3 0.1 0.4 1</ambient></material></visual><collision name="c"><geometry><box><size>8.2 0.2 1</size></box></geometry></collision></link>
      <link name="in_e"><pose>4 0 0.5 0 0 1.5708</pose><visual name="v"><geometry><box><size>8.2 0.2 1</size></box></geometry><material><ambient>0.3 0.1 0.4 1</ambient></material></visual><collision name="c"><geometry><box><size>8.2 0.2 1</size></box></geometry></collision></link>
      <link name="in_w"><pose>-4 0 0.5 0 0 1.5708</pose><visual name="v"><geometry><box><size>8.2 0.2 1</size></box></geometry><material><ambient>0.3 0.1 0.4 1</ambient></material></visual><collision name="c"><geometry><box><size>8.2 0.2 1</size></box></geometry></collision></link>

      <!-- ========================================== -->
      <!-- ZONA 1: CAMPO DE MINAS (NORTE) -->
      <!-- ========================================== -->
      <link name="mine1"><pose>-2 6 0.5 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.2</radius><length>1</length></cylinder></geometry><material><ambient>0.2 0.8 0.2 1</ambient></material></visual><collision name="c"><geometry><cylinder><radius>0.2</radius><length>1</length></cylinder></geometry></collision></link>
      <link name="mine2"><pose>0 7.2 0.5 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.2</radius><length>1</length></cylinder></geometry><material><ambient>0.2 0.8 0.2 1</ambient></material></visual><collision name="c"><geometry><cylinder><radius>0.2</radius><length>1</length></cylinder></geometry></collision></link>
      <link name="mine3"><pose>2 5 0.5 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.2</radius><length>1</length></cylinder></geometry><material><ambient>0.2 0.8 0.2 1</ambient></material></visual><collision name="c"><geometry><cylinder><radius>0.2</radius><length>1</length></cylinder></geometry></collision></link>

      <!-- ========================================== -->
      <!-- ZONA 2: LA BIFURCACIÓN (ESTE) -->
      <!-- ========================================== -->
      <!-- Pared divisoria que crea dos caminos paralelos -->
      <link name="fork_wall"><pose>6 0 0.5 0 0 1.5708</pose><visual name="v"><geometry><box><size>5 0.1 1</size></box></geometry><material><ambient>0.3 0.1 0.4 1</ambient></material></visual><collision name="c"><geometry><box><size>5 0.1 1</size></box></geometry></collision></link>
      <!-- Obstáculo escondido en la ruta derecha para obligarlo a decidir -->
      <link name="fork_trap"><pose>7 0 0.5 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.3</radius><length>1</length></cylinder></geometry><material><ambient>0.2 0.8 0.2 1</ambient></material></visual><collision name="c"><geometry><cylinder><radius>0.3</radius><length>1</length></cylinder></geometry></collision></link>

      <!-- ========================================== -->
      <!-- ZONA 3: CUELLO DE BOTELLA ZIG-ZAG (SUR) -->
      <!-- ========================================== -->
      <link name="zig1"><pose>-2 -5.0 0.5 0 0 1.5708</pose><visual name="v"><geometry><box><size>2 0.1 1</size></box></geometry><material><ambient>0.3 0.1 0.4 1</ambient></material></visual><collision name="c"><geometry><box><size>2 0.1 1</size></box></geometry></collision></link>
      <link name="zig2"><pose>2 -7.0 0.5 0 0 1.5708</pose><visual name="v"><geometry><box><size>2 0.1 1</size></box></geometry><material><ambient>0.3 0.1 0.4 1</ambient></material></visual><collision name="c"><geometry><box><size>2 0.1 1</size></box></geometry></collision></link>

      <!-- ========================================== -->
      <!-- ZONA 4: SLALOM DIAGONAL (OESTE) -->
      <!-- ========================================== -->
      <link name="slalom1"><pose>-6 2 0.5 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry><material><ambient>0.2 0.8 0.2 1</ambient></material></visual><collision name="c"><geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry></collision></link>
      <link name="slalom2"><pose>-7.2 -1 0.5 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry><material><ambient>0.2 0.8 0.2 1</ambient></material></visual><collision name="c"><geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry></collision></link>
      <link name="slalom3"><pose>-4.8 -3 0.5 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry><material><ambient>0.2 0.8 0.2 1</ambient></material></visual><collision name="c"><geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry></collision></link>

    </model>
  </world>
</sdf>